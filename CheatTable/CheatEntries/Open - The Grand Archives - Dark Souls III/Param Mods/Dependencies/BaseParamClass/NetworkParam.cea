{$lua}
if syntaxcheck then return end
[ENABLE]

-- Define NetworkParam Class

NetworkParam = BaseParamClass:new()

function NetworkParam:new(uuid, id, address)
	local o = {}
	self.__index = self
	setmetatable(o, self)

	o:init("NetworkParam", uuid, id, address)
	return o
end

