[ENABLE]
aobscanmodule(RWLoop_Call,$process,81 f9 f3 01 00 00 77 ?? 48 8b ?? ?? ?? ?? ?? 48 63 c9)
aobscanmodule(RW_Call_Call,$process,?? ?? ?? ?? 90 48 8b 50 08 48 89 53 08 48 8b 40 10 48 89 43 10 48 8d ?? ?? ?? ?? ?? 48 89 44 24 28 c7 43 18 09 00 00 00)
alloc(BsmReinforceWeapon,100,DarkSoulsIII.exe)
createthread(BsmReinforceWeapon)

BsmReinforceWeapon:
mov ebx,E8
loop:
mov edx,1
mov ecx,ebx
call RWLoop_Call
inc ebx
cmp ebx,EB
jle loop
sub rsp,48
mov rcx,RW_Call_Call
movsxd rcx,dword ptr [rcx]
mov rax,RW_Call_Call+4
add rax,rcx
lea rcx,[rsp+28]
call rax
add rsp,48
ret
{$lua}
if not syntaxcheck then disableMemrec(memrec) end
{$asm}
[DISABLE]
dealloc(BsmReinforceWeapon)
