[ENABLE]
aobscanmodule(BAttune_AOB,$process,48 8D 45 0F 48 89 45 EF 48 8D 45 0F 48 89 45 F7 48 8D ?? ?? ?? ?? ?? 48 89 45 0F 48 8D ?? ?? ?? ?? ?? 48 89 45 0F 48 8D ?? ?? ?? ?? ?? 48 89 45 17)
define(BAttune_Call,BAttune_AOB-39)
alloc(BonfireAttuneSpell,100,DarkSoulsIII.exe)
