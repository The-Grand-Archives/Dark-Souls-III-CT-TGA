]]
local sharedAccessoryValues = {
  900200, 900201, 900202, 900204, 900210, 900211, 900212, 910000
}
for i,id in ipairs(sharedAccessoryValues) do
local Accessory = EquipParamAccessory:new("CustomShop",id)
Accessory:patch4Byte(0x10,0)
Accessory:patch4Byte(0x14,0)
Accessory:patch4Byte(0x40,0)
end
