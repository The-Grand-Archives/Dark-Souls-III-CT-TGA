[ENABLE]
{$lua}
if syntaxcheck then return end
local sharedShopValues = {
  900000, 900001, 900002, 900003, 900004, 900005, 900006, 900007, 900008,
  900009, 900010, 900011, 900012, 900013, 900014, 900015, 900016, 900017,
  900018, 900019, 900020, 900021, 900022, 900023, 900024, 900025, 900026,
  900027, 900028, 900029, 900030, 900031, 900032, 900033, 900034, 900035,
  900036, 900037, 900038, 900039, 900040, 900041, 900042, 900043, 900044,
  900045, 900046, 900047, 900048, 900049, 900050, 900051, 900052, 900053,
  900054, 900055, 900056, 900057, 900058, 900059, 900060, 900061, 900062,
  900063, 900064, 900065
}
for i,id in ipairs(sharedShopValues) do
local Inventory = ShopLineupParam:new("CustomShop",id)
Inventory:Value(0)
Inventory:EventFlag(-1)
Inventory:SellQuantity(-1)
Inventory:PriceRate(1)
end

local sharedWeaponValues = {
  890000
}
for i,id in ipairs(sharedWeaponValues) do
local Weapon = EquipParamWeapon:new("CustomShop",id)
Weapon:patch4Byte(0x14,0)
Weapon:patch4Byte(0x18,0)
Weapon:patch4Byte(0x1C,0)
Weapon:patch4Byte(0x22C,0)
end
--[[
