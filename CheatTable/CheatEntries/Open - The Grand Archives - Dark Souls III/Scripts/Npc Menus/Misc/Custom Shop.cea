Goods:patch4Byte(0x70,0)
end
]]
local shop_00 = ShopLineupParam:new("CustomShop",900000)
shop_00:EquipId(890000)
shop_00:EquipType(0)
local shop_01 = ShopLineupParam:new("CustomShop",900001)
shop_01:EquipId(900200)
shop_01:EquipType(2)
