[ENABLE]
aobscanmodule(LT_Call_Call,$process,?? ?? ?? ?? 90 48 8b 50 08 48 89 53 08 48 8b 40 10 48 89 43 10 48 8d ?? ?? ?? ?? ?? 48 89 44 24 28 c7 43 18 12 00 00 00)
alloc(LudlethTranspose,100,DarkSoulsIII.exe)
createthread(LudlethTranspose)

LudlethTranspose:
sub rsp,48
mov rdx,#30000
mov r8,#31000
mov rcx,LT_Call_Call
movsxd rcx,dword ptr [rcx]
mov rax,LT_Call_Call+4
add rax,rcx
lea rcx,[rsp+28]
call rax
add rsp,48
ret
{$lua}
if not syntaxcheck then disableMemrec(memrec) end
{$asm}
[DISABLE]
dealloc(LudlethTranspose)
