[ENABLE]
aobscanmodule(PBuy_Call_Call,$process,?? ?? ?? ?? 90 48 8b 50 08 48 89 53 08 48 8b 40 10 48 89 43 10 48 8d ?? ?? ?? ?? ?? 48 89 44 24 28 c7 43 18 05 00 00 00)
alloc(PatchesShop,100,DarkSoulsIII.exe)
createthread(PatchesShop)

PatchesShop:
sub rsp,48
mov rdx,#200000
mov r8, #209999
mov rcx,PBuy_Call_Call
movsxd rcx,dword ptr [rcx]
mov rax,PBuy_Call_Call+4
add rax,rcx
lea rcx,[rsp+28]
call rax
add rsp,48
ret

{$lua}
if not syntaxcheck then disableMemrec(memrec) end
{$asm}
[DISABLE]
dealloc(PatchesShop)
