[ENABLE]
aobscanmodule(CBuy_Call_Call,$process,?? ?? ?? ?? 90 48 8b 50 08 48 89 53 08 48 8b 40 10 48 89 43 10 48 8d ?? ?? ?? ?? ?? 48 89 44 24 28 c7 43 18 05 00 00 00)
alloc(CornyxShop,100,DarkSoulsIII.exe)
createthread(CornyxShop)

CornyxShop:
sub rsp,48
mov rdx,#140000
mov r8, #140099
mov rcx,CBuy_Call_Call
movsxd rcx,dword ptr [rcx]
mov rax,CBuy_Call_Call+4
add rax,rcx
lea rcx,[rsp+28]
