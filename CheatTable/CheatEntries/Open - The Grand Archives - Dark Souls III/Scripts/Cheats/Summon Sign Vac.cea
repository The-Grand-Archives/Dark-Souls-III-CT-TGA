   mov eax,[rbx+80]
   mov [rsi+08],eax
   mov eax,[rax+84]
   mov [rsi+0C],eax
   mov eax,[rax+88]
   mov [rsi+10],eax
   pop rbx
   pop rax

   jmp SignVac_Return

 SignVac_AOB:
 jmp SignVac
 SignVac_Return:

 //-------------------------------------------------- SignVac --------------------------------------------------//
