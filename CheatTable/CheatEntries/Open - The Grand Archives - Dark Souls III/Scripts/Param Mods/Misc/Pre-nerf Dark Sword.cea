{$lua}
if syntaxcheck then return end
[ENABLE]
local darkswords = {
  6240000, 6240100, 6240200, 6240300, 6240400, 6240500, 6240600, 6240700,
  6240800, 6240900, 6241000, 6241100, 6241200, 6241300, 6241400, 6241500
}
for i,id in ipairs(darkswords) do
local weapon = EquipParamWeapon:new("preNerfDarkSword",id)
weapon:saWeaponDamage(20)
weapon:wepAbsorbPosId(0.5)
weapon:staminaConsumeRate(1.154)
end

local normal = EquipParamWeapon:new("preNerfDarkSword",6240000)
