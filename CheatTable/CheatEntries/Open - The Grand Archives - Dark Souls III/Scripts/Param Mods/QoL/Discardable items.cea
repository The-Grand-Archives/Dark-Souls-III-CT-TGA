{cscript}
//Ported to C from script by: inuNorii
//Allow discarding any items
[ENABLE]
{$c}
#include <tga/params.h>
int on_enable() {
    ParamPatchBegin("discardable_items");
    ParamPatchAll(EquipParamWeapon, { param->IsDiscard = 1; });
    ParamPatchAll(EquipParamProtector, { param->IsDiscard = 1; });
    ParamPatchAll(EquipParamAccessory, { param->IsDiscard = 1; });
    ParamPatchAll(EquipParamGoods, { param->isDiscard = 1; });
    ParamPatchEnd();
    return 0;
}

int on_disable() {
    ParamRestore("discardable_items");
    return 0;
}

{$asm}
[DISABLE]

