{
  Author: Lucifer
  Description: All Unused Weapon's
}
[ENABLE]
{$lua}
if syntaxcheck then return end
--Firelink Greatsword/Missionary Axe
  local equipWeapon = EquipParamWeapon:new("UnusedWeapons",0x0060BDA0)
  equipWeapon:patch2Byte(0xb8,709)
  equipWeapon:patch2Byte(0xba,1080)
--Greataxe/Four Knight's Hammer
  local equipWeapon = EquipParamWeapon:new("UnusedWeapons",0x006B9310)
  equipWeapon:patch2Byte(0xb8,821)
  equipWeapon:patch2Byte(0xba,1208)
--Greataxe/Four Knight's Hammer (Infusion)
local Infusion1 = {
  0x006B9374, -- Heavy
  0x006B93D8, -- Sharp
  0x006B943C, -- Refined
  0x006B94A0, -- Simple
  0x006B9504, -- Crystal
  0x006B9568, -- Fire
  0x006B95CC, -- Chaos
  0x006B9630, -- Lightning
  0x006B9694, -- Deep
  0x006B96F8, -- Dark
  0x006B975C, -- Poison
  0x006B97C0, -- Blood
  0x006B9824, -- Raw
  0x006B9888, -- Blessed
  0x006B98EC, -- Hollow
}
for i,id in ipairs(Infusion1) do
  local equipWeapon = EquipParamWeapon:new("Infusion",id)
  equipWeapon:patch2Byte(0xb8,821)
  equipWeapon:patch2Byte(0xba,1208)
end
