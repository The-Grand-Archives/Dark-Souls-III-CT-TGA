{$asm}
[[[[MsgRepository]+8]+0]+50]+1E9AA:
dw 'Smoldering Shortsword',0
[[[[MsgRepository]+8]+0]+C0]+BD334:
dw 'A relic from an age where the chaos flame burned bright.',A
