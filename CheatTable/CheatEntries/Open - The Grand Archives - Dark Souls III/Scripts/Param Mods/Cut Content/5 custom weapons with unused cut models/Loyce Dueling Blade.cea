local newWa = BehaviorParam_PC:new("loycecrescent",103650700)
newWa:refType(2)
newWa:refId(1902)
newWa:stamina(30)

local bonusVfx = SpEffectParam:new("loycecrescent",1902)
bonusVfx:cycleOccurrenceSpEffectId(1903)
bonusVfx:effectSfx(800000)

local ivoryWeapon = SpEffectParam:new("loycecrescent",1903)
ivoryWeapon:effectEndurance(60)
ivoryWeapon:spCategory(20)
ivoryWeapon:effectSfx(91040700)--91040700
