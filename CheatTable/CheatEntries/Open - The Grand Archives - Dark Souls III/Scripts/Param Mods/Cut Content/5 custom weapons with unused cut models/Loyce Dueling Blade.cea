{$asm}
[[[[MsgRepository]+8]+0]+50]+1B350:
dw 'Loyce Dueling Blade',0
[[[[MsgRepository]+8]+0]+C0]+87462:
dw 'The blade of a dignitary who hailed from the cold domain of a distant monarch in search of aid.',A
dw '',A
dw 'He died, hopeless and alone in a foreign land, and this curious blade pried from his cold dead hands.',A
dw '',A
dw 'Skill: Ivory Splendor',A
dw 'Brace and charge forward, then ignite the signature magic of Eleum Loyce.',0
[[[[MsgRepository]+08]+00]+0640]+A562:
dw 'Ivory Splendor',0

[DISABLE]
{$lua}
paramUtils:restore("loycecrescent")

{$asm}
[[[[MsgRepository]+8]+0]+50]+1B350:
dw 'Crescent Moon Sword',0
[[[[MsgRepository]+8]+0]+C0]+87462:
dw 'Ringfinger Leonhard',27,'s weapon of choice, a type of shotel imbued with the power of the moon.',A
