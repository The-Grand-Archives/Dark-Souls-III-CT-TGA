local selfPoison = SpEffectParam:new("butcherrevenant",130050400)
selfPoison:poizonAttackPower(200)
selfPoison:registBlood(0)
selfPoison:stateInfo(2)
selfPoison:effectEndurance(60)
selfPoison:motionInterval(.5)
selfPoison:changeHpRate(.1)
