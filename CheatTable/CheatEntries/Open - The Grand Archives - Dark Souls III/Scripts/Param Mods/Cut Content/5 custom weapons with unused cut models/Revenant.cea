local newVfxL = SpEffectParam:new("butcherrevenant",130050451)
newVfxL:effectEndurance(15)
newVfxL:effectSfx(5652)
newVfxL:cycleOccurrenceSpEffectId(12240)

local newBuffR = SpEffectParam:new("butcherrevenant",130050432)--atkOccurrenceSpEffectId(130050432) from speffectid 130050431
newBuffR:registIllness(30)
