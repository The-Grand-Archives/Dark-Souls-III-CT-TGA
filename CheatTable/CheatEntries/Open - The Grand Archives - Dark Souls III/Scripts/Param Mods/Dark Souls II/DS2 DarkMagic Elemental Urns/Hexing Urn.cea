//Written by Boblord
//replaces yellow bug pellet with hexing urn from ds2(dark dmg firebomb)

[ENABLE]
{$lua}
if syntaxcheck then return end
local YellowBug = EquipParamGoods:new("hexingurn",460)
YellowBug:refId(41831)
YellowBug:goodsUseAnim(3)
YellowBug:iconId(128) -- icon: poison gem, looks pretty good
YellowBug:maxNum(20) -- holds up to 20 at a time
YellowBug:refCategory(1) -- bullet
YellowBug:sfxId(523083)
YellowBug:reinforceTypeId(2100)

