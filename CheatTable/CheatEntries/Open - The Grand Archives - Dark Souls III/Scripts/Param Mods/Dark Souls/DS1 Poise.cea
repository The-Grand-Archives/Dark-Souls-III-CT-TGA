//Author: inuNorii
//Restores poise functionality from DS1 for specific armour sets
{$lua}
if syntaxcheck then return end
[ENABLE]
--why do these have the poise effect lmao
local nakedIds = {900000, 901000, 902000, 903000}
for i,id in ipairs(nakedIds) do
local protector = EquipParamProtector:new("DS1Poise",id)
protector:residentSpEffectId2(-1)
end

--set poise effect and SARecover
local sharedArmourIds = {
      54000000,54001000,54002000,54003000,
      54500000,54501000,54502000,54503000,
      70000000,70001000,70002000,70003000,
      71000000,71001000,71002000,71003000,
      72000000,72001000,72002000,72003000,
      74000000,74001000,74002000,74003000,
      74500000,74501000,74502000,74503000,
      75000000,75001000,75002000,75003000,
      82000000,82001000,82002000,82003000,
      83000000,83001000,83002000,83003000,
      84000000,84001000,84002000,84003000,
      85000000,85001000,85002000,85003000,
      87000000,87001000,87002000,87003000,
      90000000,90001000,90002000,90003000,
      92000000,92001000,92002000,92003000,
      93000000,93001000,93002000,93003000,
      94000000,94001000,94002000,94003000,
      96000000,96001000,96002000,96003000
}
for i,id in ipairs(sharedArmourIds) do
local protector2 = EquipParamProtector:new("DS1Poise",id)
protector2:residentSpEffectId2(6300)
protector2:corectSARecover(-0.1)
protector2:poise(1)
end

--Black Knight Set
local BK0 = EquipParamProtector:new("DS1Poise",54000000)
