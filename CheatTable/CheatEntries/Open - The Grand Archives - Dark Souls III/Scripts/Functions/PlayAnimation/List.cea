local animList = createStringlist()
animList.beginUpdate()
for _,str in pairs(eventnameid) do
	animList.add(str)
end
animList.endUpdate()

local _,anim = showSelectionList("W_Event", "Select animation string", animList)
if anim ~= nil and anim ~= "" then
   PlayAnimation(anim)
end
disableMemrec(memrec)

