[ENABLE]
{$lua}
if syntaxcheck then return end

-- change these for options
local unlock_gestures = true		-- set this to false if you want to lock all gestures
local give_cut_gestures = false
local give_unused_gestures = false

-- do not change the rest

local gestures = {
	{  2, 0x40002329 }, -- Point forward
	{  4, 0x40002330 }, -- Point up
	{  6, 0x40002331 }, -- Point down
	{  8, 0x4000232E }, -- Wave
	{ 10, 0x40002328 }, -- Beckon
	{ 12, 0x40002341 }, -- Call over
	{ 14, 0x40002337 }, -- Welcome
	{ 16, 0x40002345 }, -- Applause
	{ 18, 0x40002343 }, -- Quiet Resolve
	{ 20, 0x4000232C }, -- Jump for joy
	{ 22, 0x40002338 }, -- Joy
	{ 24, 0x4000233A }, -- Rejoice
	{ 26, 0x4000232A }, -- Hurrah!
	{ 28, 0x4000232F }, -- Praise the Sun
	{ 30, 0x40002339 }, -- My thanks!
	{ 32, 0x4000232B }, -- Bow
	{ 34, 0x40002335 }, -- Proper bow
	{ 36, 0x4000233D }, -- Dignified bow
	{ 38, 0x4000232D }, -- Duel bow
	{ 40, 0x40002347 }, -- Legion Etiquette
	{ 42, 0x40002348 }, -- Darkmoon Loyalty
	{ 44, 0x4000233C }, -- By my sword
	{ 46, 0x40002336 }, -- Prayer
	{ 48, 0x4000234B }, -- Silent Ally!
	{ 50, 0x4000233B }, -- Rest
	{ 52, 0x40002342 }, -- Collapse
	{ 54, 0x40002344 }, -- Patches Squat
	{ 56, 0x40002334 }, -- Prostration
	{ 58, 0x4000234A }, -- Toast
	{ 60, 0x40002349 }, -- Sleep
	{ 62, 0x4000233F }, -- Curl up
	{ 64, 0x40002340 }, -- Stretch out
	{ 66, 0x40002346 }  -- Path of the Dragon
}

local cut_gestures = {
	{ 68, 0xFFFFFFFF }, -- Unmannered Bow
	{ 70, 0xFFFFFFFF }  -- Lord of Cinder
}

local unused_gestures = {
	{ 72, 0xFFFFFFFF }, -- FDP_MenuText(301140)
	{ 74, 0xFFFFFFFF }, -- FDP_MenuText(301141)
	{ 76, 0xFFFFFFFF }, -- FDP_MenuText(301142)
	{ 78, 0xFFFFFFFF }, -- FDP_MenuText(301143)
	{ 80, 0xFFFFFFFF }, -- FDP_MenuText(301144)
	{ 82, 0xFFFFFFFF }  -- FDP_MenuText(301145)
}

local GameDataMan = readPointer("GameDataMan")
local PlayerGameData = readPointer(GameDataMan + 0x10)
local GestureGameData = readPointer(PlayerGameData + 0x7B8)

-- cut content / unused gestures
if give_cut_gestures then
	for _,v in ipairs(cut_gestures) do
		table.insert(gestures, v)
	end
end

if give_unused_gestures then
	for _,v in ipairs(unused_gestures) do
		table.insert(gestures, v)
	end
end

local addval = 0
if unlock_gestures then addval = 1 end

for i,v in ipairs(gestures) do
	if v[1] ~= -1 then
		writeInteger(GestureGameData + 4 + i * 4, v[1] + addval)
		--ItemPopup(v[2],1)
	end
end

disableMemrec(memrec)

[DISABLE]