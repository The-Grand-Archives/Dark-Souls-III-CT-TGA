{$lua}
if syntaxcheck then return end
[ENABLE]
function throwError(string, variation)
	if variation == nil or variation == 0 then
		ShowMessage(string)
	elseif variation == 1 then
		printf(string)
	end
	error(string, 2)
end

function missingDlc(dlc)
	local dlcNames = {
		[0] = "",
		[1] = "Ashes of Ariandel",
		[2] = "The Ringed City"
	}

	local e = "You do not own "..dlcNames[dlc]

	throwError(e)
end

[DISABLE]
throwError = nil
missingDlc = nil
