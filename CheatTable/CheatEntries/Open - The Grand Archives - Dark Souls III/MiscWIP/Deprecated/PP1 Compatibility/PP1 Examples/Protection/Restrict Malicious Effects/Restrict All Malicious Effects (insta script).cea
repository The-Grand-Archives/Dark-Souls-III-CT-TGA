	  {5101,0x16c,"04"}, --Leeches
	  {7020,0x16c,"04"}, --7020
	  {7030,0x16c,"04"}, --7030
	  {7080,0x16c,"04"}, --7080
	  {7092,0x16c,"04"}, --7092
	  {7120,0x16c,"04"}, --7120
	  {7130,0x16c,"04"}, --7130
	  {7135,0x16c,"04"}, --7135
