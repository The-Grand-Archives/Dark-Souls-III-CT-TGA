[ENABLE]
{$lua}
if syntaxcheck then return end
local Club = { --Good param mods
  {8000000,0xEE,"00"}, --0 Strength Requirement [Array of Byte format]
}
paramUtils:paramIterator("EquipParamWeapon",Club,"ClubW") --Save values on 'enable'

[DISABLE]
{$lua}
if syntaxcheck then return end
 paramUtils:paramDepatcher("ClubW") --Restore default values on 'disable'



