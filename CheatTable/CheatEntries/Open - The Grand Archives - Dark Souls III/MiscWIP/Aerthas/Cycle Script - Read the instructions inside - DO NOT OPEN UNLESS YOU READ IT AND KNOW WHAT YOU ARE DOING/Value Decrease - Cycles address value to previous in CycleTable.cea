[ENABLE]
{$lua}
if CycleTableValue > 1 then
   CycleTableValue = CycleTableValue - 1
end
print(CycleTableValue .. " : "..CycleTable[CycleTableValue])
writeInteger(CycleAddress,CycleTable[CycleTableValue])
{$asm}
[DISABLE]
{$lua}
if CycleTableValue > 1 then
   CycleTableValue = CycleTableValue - 1
end
print(CycleTableValue .. " : "..CycleTable[CycleTableValue])
writeInteger(CycleAddress,CycleTable[CycleTableValue])
{$asm}


